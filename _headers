# Netlify: правила кешування.
# Файл кладеться в корінь сайту, поруч з index.html.

# JS і CSS браузер має перевіряти на свіжість при кожному завантаженні.
# Якщо файл не змінився — сервер відповість 304 і віддасть копію з кешу,
# трафіку це майже не додає. Якщо змінився — прилетить нова версія одразу.
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Картинки й шрифти навпаки — хай лежать у кеші довго,
# вони змінюються рідко і важать більше.
/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
